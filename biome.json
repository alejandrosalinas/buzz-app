{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!.hermit",
      "!!dist",
      "!!dist-author",
      "!!dist-plugins",
      "!!dist-buzz-mcp",
      "!!.profiles",
      "!!src-tauri/target",
      "!!src-tauri/gen",
      "!!target",
      "!!test-results",
      "!!tests/fixtures/design-system/flake-selection-*",
      "!tests/fixtures/read-state-vectors.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "useExhaustiveDependencies": "error" },
      "suspicious": {
        "noUnknownAtRules": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "lucide*",
                  "lucide*/**",
                  "@lucide/**",
                  "@tabler/icons*",
                  "@tabler/icons*/**",
                  "react-icons",
                  "react-icons/**",
                  "@heroicons/**",
                  "@fortawesome/**",
                  "@iconify/**",
                  "iconoir*",
                  "iconoir*/**",
                  "iconsax*",
                  "iconsax*/**",
                  "@radix-ui/react-icons",
                  "@radix-ui/react-icons/**",
                  "phosphor-react",
                  "phosphor-react/**",
                  "@phosphor-icons/**"
                ],
                "message": "Use the shared design-system/icons gateway; Tabler only."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**", "!tests/browser/page-errors.mjs"],
      "plugins": ["./tests/browser/page-errors.grit"]
    },
    {
      "includes": ["**"],
      "plugins": ["./tests/browser/fixed-sleeps.grit"]
    },
    {
      "includes": [
        "src/**/*.tsx",
        "!src/**/*.test.tsx",
        "!src/features/profiles/AvatarEditor.tsx",
        "!src/bundled/agents/AgentCreateHeader.tsx"
      ],
      "plugins": ["./src/shared/avatar-source.grit"]
    },
    {
      "includes": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.{ts,tsx}",
        "!src/shared/clipboard.ts"
      ],
      "plugins": ["./src/shared/clipboard.grit"]
    },
    {
      "includes": [
        "tests/browser/**",
        "src/**",
        "!tests/browser/playwright-test.mjs"
      ],
      "plugins": ["./tests/browser/playwright-test.grit"]
    },
    {
      "includes": ["src/shared/design-system/icons/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "lucide*",
                      "lucide*/**",
                      "@lucide/**",
                      "react-icons",
                      "react-icons/**",
                      "@heroicons/**",
                      "@fortawesome/**",
                      "@iconify/**",
                      "iconoir*",
                      "iconoir*/**",
                      "iconsax*",
                      "iconsax*/**",
                      "@radix-ui/react-icons",
                      "@radix-ui/react-icons/**",
                      "phosphor-react",
                      "phosphor-react/**",
                      "@phosphor-icons/**"
                    ],
                    "message": "Tabler only."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
